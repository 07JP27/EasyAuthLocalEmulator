@page "/.auth/login/{provider}"
@model EasyAuthLocalEmulator.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Local authentication";
}

<header class="auth-header">
    <p class="product-name">Easy Auth Local Emulator</p>
    <p class="platform-name">Emulating: @Model.PlatformDisplayName</p>
    <h1>Local authentication</h1>
    <p>Create a development-only @Model.ProviderDisplayName identity for this local session. It cannot be used with external provider APIs.</p>
</header>

<section class="auth-form" aria-labelledby="identity-heading">
    <h2 id="identity-heading" class="visually-hidden">Identity details</h2>

    <div class="form-row">
        <label for="provider-name">Provider</label>
        <div class="control">
            <input id="provider-name" type="text" value="@Model.Provider" readonly aria-readonly="true" />
            <p class="help">@Model.ProviderDisplayName</p>
            <details class="provider-change">
                <summary>Change provider</summary>
                <nav aria-label="Identity providers">
                    @foreach (EasyAuthLocalEmulator.Auth.IdentityProviderDefinition provider in Model.Providers)
                    {
                        string href = $"/.auth/login/{provider.RouteKey}";
                        if (!string.IsNullOrEmpty(Model.PostLoginRedirectUri))
                        {
                            href += $"?post_login_redirect_uri={Uri.EscapeDataString(Model.PostLoginRedirectUri)}";
                        }

                        <a href="@href"
                           aria-current="@(provider.RouteKey == Model.Provider ? "page" : null)">
                            @provider.DisplayName
                        </a>
                    }
                </nav>
            </details>
        </div>
    </div>

    @if (Model.ProfileNames.Count > 0)
    {
        <form method="get" action="/.auth/login/@Model.Provider" class="form-row profile-row">
            @if (!string.IsNullOrEmpty(Model.PostLoginRedirectUri))
            {
                <input type="hidden" name="post_login_redirect_uri" value="@Model.PostLoginRedirectUri" />
            }
            <label for="profile-preset">Profile</label>
            <div class="control">
                <div class="inline-control">
                    <select id="profile-preset" name="profile">
                        @foreach (string profileName in Model.ProfileNames)
                        {
                            <option value="@profileName" selected="@(profileName == Model.SelectedPresetName ? "selected" : null)">
                                @profileName
                            </option>
                        }
                    </select>
                    <button type="submit" class="button secondary">Load</button>
                </div>
                <p class="help">Load a profile from the configuration file.</p>
            </div>
        </form>
    }

    <form method="post" asp-route-provider="@Model.Provider" data-provider="@Model.Provider" id="identity-form">
        <input type="hidden" asp-for="PostLoginRedirectUri" />

        <div asp-validation-summary="ModelOnly" class="form-message"></div>

        <div class="form-row">
            <label asp-for="Input.DisplayName"></label>
            <div class="control">
                <input asp-for="Input.DisplayName" autocomplete="name" />
                <span asp-validation-for="Input.DisplayName"></span>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.UserName"></label>
            <div class="control">
                <input asp-for="Input.UserName" autocomplete="username" />
                <span asp-validation-for="Input.UserName"></span>
                <p class="help">User name, login, or email address exposed to the application.</p>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.UserId"></label>
            <div class="control">
                <input asp-for="Input.UserId" spellcheck="false" />
                <span asp-validation-for="Input.UserId"></span>
                <p class="help">Unique identifier exposed in <code>X-MS-CLIENT-PRINCIPAL-ID</code>.</p>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.TenantId"></label>
            <div class="control">
                <input asp-for="Input.TenantId" spellcheck="false" />
                <span asp-validation-for="Input.TenantId"></span>
                <p class="help">Required for Microsoft Entra ID; optional for other providers.</p>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.Issuer"></label>
            <div class="control">
                <input asp-for="Input.Issuer" spellcheck="false" />
                <span asp-validation-for="Input.Issuer"></span>
                <p class="help">Emitted as an <code>iss</code> claim. Leave blank to omit it.</p>
            </div>
        </div>

        <fieldset class="form-row">
            <legend>Roles</legend>
            <div class="control">
                <div id="roles" class="repeat-list" data-repeat data-template="role-template">
                    @for (int index = 0; index < Model.Input.Roles.Count; index++)
                    {
                        <div class="repeat-row" data-row>
                            <div>
                                <label class="visually-hidden" for="Input_Roles_@(index)__">Role</label>
                                <input id="Input_Roles_@(index)__" name="Input.Roles[@index]" value="@Model.Input.Roles[index]" />
                            </div>
                            <button type="button" class="button remove" data-remove>Remove</button>
                        </div>
                    }
                </div>
                <button type="button" class="button add" data-add="roles">Add role</button>
                <p class="help">Each role becomes a separate claim using the configured role claim type.</p>
            </div>
        </fieldset>

        <fieldset class="form-row">
            <legend>Custom claims</legend>
            <div class="control">
                <div id="claims" class="repeat-list" data-repeat data-template="claim-template">
                    @for (int index = 0; index < Model.Input.Claims.Count; index++)
                    {
                        <div class="repeat-row claim-row" data-row>
                            <div>
                                <label for="Input_Claims_@(index)__Type">Type</label>
                                <input id="Input_Claims_@(index)__Type" name="Input.Claims[@index].Type" value="@Model.Input.Claims[index].Type" />
                            </div>
                            <div>
                                <label for="Input_Claims_@(index)__Value">Value</label>
                                <input id="Input_Claims_@(index)__Value" name="Input.Claims[@index].Value" value="@Model.Input.Claims[index].Value" />
                            </div>
                            <button type="button" class="button remove" data-remove>Remove</button>
                        </div>
                    }
                </div>
                <button type="button" class="button add" data-add="claims">Add claim</button>
                <p class="help">Duplicate claim types are preserved in the order entered.</p>
            </div>
        </fieldset>

        <details class="advanced">
            <summary>
                <span class="disclosure-marker" aria-hidden="true"></span>
                <span>Advanced compatibility settings</span>
                <span class="summary-meta">Optional</span>
            </summary>
            <div class="advanced-fields">
                <div class="form-row">
                    <label asp-for="Input.AuthenticationType"></label>
                    <div class="control"><input asp-for="Input.AuthenticationType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.NameClaimType"></label>
                    <div class="control"><input asp-for="Input.NameClaimType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.RoleClaimType"></label>
                    <div class="control"><input asp-for="Input.RoleClaimType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.DisplayNameClaimType"></label>
                    <div class="control"><input asp-for="Input.DisplayNameClaimType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.UserNameClaimType"></label>
                    <div class="control"><input asp-for="Input.UserNameClaimType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.UserIdClaimType"></label>
                    <div class="control"><input asp-for="Input.UserIdClaimType" spellcheck="false" /></div>
                </div>
                <div class="form-row">
                    <label asp-for="Input.TenantIdClaimType"></label>
                    <div class="control"><input asp-for="Input.TenantIdClaimType" spellcheck="false" /></div>
                </div>
            </div>
            <p class="help advanced-help">Blank claim mappings suppress the corresponding convenience claim.</p>
        </details>

        <div class="form-actions">
            <button type="reset" class="button secondary">Reset</button>
            <button type="submit" class="button primary">Sign in</button>
        </div>
        <p class="session-note">The profile stays in memory until logout, expiry, or process exit.</p>
    </form>
</section>

<template id="role-template">
    <div class="repeat-row" data-row>
        <div>
            <label class="visually-hidden" for="Input_Roles___index____">Role</label>
            <input id="Input_Roles___index____" name="Input.Roles[__index__]" />
        </div>
        <button type="button" class="button remove" data-remove>Remove</button>
    </div>
</template>

<template id="claim-template">
    <div class="repeat-row claim-row" data-row>
        <div>
            <label for="Input_Claims___index____Type">Type</label>
            <input id="Input_Claims___index____Type" name="Input.Claims[__index__].Type" />
        </div>
        <div>
            <label for="Input_Claims___index____Value">Value</label>
            <input id="Input_Claims___index____Value" name="Input.Claims[__index__].Value" />
        </div>
        <button type="button" class="button remove" data-remove>Remove</button>
    </div>
</template>

@section Scripts {
    <script src="/.auth/assets/login.js" defer></script>
}
